    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* --- VARIABEL & RESET --- */
        :root {
            --primary: rgb(163, 0, 0);
            --primary-dark: rgb(216, 29, 135);
            --dark: #0f172a;
            --gray: #64748b;
            --light: #f8fafc;
            --white: #ffffff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Poppins', sans-serif;
            line-height: 1.6;
            color: var(--dark);
            background: var(--white);
        }

        html { scroll-behavior: smooth; }
        a { text-decoration: none; color: inherit; }

        /* --- HEADER & NAV --- */
        header {
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            z-index: 1000;
            padding: 1rem 5%;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary);
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            font-weight: 500;
            font-size: 0.95rem;
            transition: 0.3s;
        }

        .nav-links a:hover { color: var(--primary); }
        .menu-toggle { display: none; font-size: 1.5rem; cursor: pointer; color: var(--dark); }

        /* --- SECTION GENERAL --- */
        section { padding: 100px 5% 80px 5%; }

        .section-title {
            text-align: center;
            margin-bottom: 3rem;
        }

        .section-title h2 {
            font-size: 2rem;
            color: var(--dark);
            margin-bottom: 0.5rem;
        }

        .section-title p { color: var(--gray); }

        /* --- HERO SECTION --- */
        .hero {
            min-height: 90vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            background: radial-gradient(circle at top right, #dbeafe 0%, var(--white) 60%);
            padding-top: 120px;
        }

        .hero-content { max-width: 800px; }
        .hero-content h1 { font-size: 3rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark); }
        .hero-content h1 span { color: var(--primary); }
        .hero-content p { font-size: 1.1rem; color: var(--gray); margin-bottom: 2rem; }
        
        .btn-container { display: flex; gap: 1rem; justify-content: center; }
        .btn { padding: 0.8rem 2rem; border-radius: 30px; font-weight: 600; transition: 0.3s; cursor: pointer; }
        .btn-primary { background: var(--primary); color: var(--white); }
        .btn-primary:hover { background: var(--primary-dark); }
        .btn-secondary { background: transparent; color: var(--primary); border: 2px solid var(--primary); }
        .btn-secondary:hover { background: var(--light); }

        /* --- SKILLS TABLE STYLE --- */
        .skills-table {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            border-collapse: collapse;
            background: var(--white);
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border-radius: 10px;
            overflow: hidden;
        }
        .skills-table th, .skills-table td { padding: 1rem 1.5rem; text-align: left; }
        .skills-table th { background: var(--primary); color: var(--white); font-weight: 600; }
        .skills-table tr { border-bottom: 1px solid #e2e8f0; }
        .skills-table tr:last-child { border: none; }

        /* --- HOVER EFFECTS & FIXES --- */
        .social-btn:hover {
            background: rgba(255,255,255,0.2) !important;
            transform: translateY(-3px);
        }

        /* --- TAB BUTTON ACTIVE STYLE --- */
        .tab-btn.active {
            background: var(--primary) !important;
            color: var(--white) !important;
        }

        /* --- RESPONSIVE --- */
        @media (max-width: 768px) {
            .menu-toggle { display: block; }
            .nav-links {
                position: fixed;
                top: 70px; left: -100%;
                width: 100%;
                background: var(--white);
                flex-direction: column;
                padding: 2rem;
                gap: 1.5rem;
                transition: 0.3s;
                box-shadow: 0 10px 10px rgba(0,0,0,0.05);
                text-align: center;
            }
            .nav-links.active { left: 0; }
            .hero-content h1 { font-size: 2.2rem; }
        }
    </style>
</head>
